# Backend Environment Variables
# Copy this file to .env and fill in your values

# Server
PORT=5000
NODE_ENV=development

# Database (MongoDB Atlas - preferred)
# Replace <username>, <password>, and <cluster-url> with your Atlas values.
# Keep /borrowbox as the database name. Never commit real credentials.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/borrowbox?retryWrites=true&w=majority

# Database (local MongoDB fallback)
MONGO_URI=mongodb://localhost:27017/borrowbox

# JWT (generate a strong secret for production)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173