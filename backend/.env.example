# Backend Environment Variables
# Copy this file to .env and fill in your values

# Server
PORT=5000
NODE_ENV=development

# Database (MongoDB Atlas - preferred)
# Replace <username>, <password>, and <cluster-url> with your Atlas values.
# Keep /borrowbox as the database name. Never commit real credentials.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/borrowbox?retryWrites=true&w=majority

# Database (local MongoDB fallback)
MONGO_URI=mongodb://localhost:27017/borrowbox

# JWT (production requires a non-default secret of at least 32 characters;
# replace this example value)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Optional one-time admin bootstrap for `npm run create:admin`
# Leave these commented out for normal server runs. Provide them in the
# command environment instead of committing a real password.
# ADMIN_NAME=BorrowBox Admin
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=replace-with-a-strong-password